# Durable Postgres storage (Neon since T10). DATABASE_URL must be postgresql://
# — the pooled endpoint (-pooler host) with pgbouncer=true is serverless-safe.
# DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1"
# One-off schema pushes can use the direct (non-pooled) endpoint:
# DATABASE_URL_DIRECT="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
# The Vitest suite runs against a DEDICATED throwaway project (truncated per file):
# DATABASE_URL_TEST="postgresql://user:pass@ep-yyy.region.aws.neon.tech/neondb?sslmode=require"

# Self-hosted GPU tier (optional - activates the selfhosted adapter, highest priority)
# Any queue-style gateway works; see src/lib/providers/selfhosted.ts for the
# two-endpoint HTTP contract (POST /v1/video/jobs, GET /v1/video/jobs/{id}).
# SELFHOSTED_URL="https://gpu.example.com"
# SELFHOSTED_MODEL="wan2.2-t2v-5b"
# SELFHOSTED_API_KEY="bearer-token"

# Hosted fal.ai-style adapter (optional - used when SELFHOSTED_URL is unset)
# FAL_KEY=""
# FAL_MODEL=""
# FAL_WEBHOOK_SECRET=""

# Public origin used for absolute OpenGraph URLs on /share/<token> pages
# (falls back to http://localhost:3000 when unset).
# NEXT_PUBLIC_SITE_URL="https://reelforge.example.com"

# ffmpeg binary override (optional - Phase 6 runtime layer auto-detects:
# FFMPEG_PATH > /usr/bin/ffmpeg > bundled ffmpeg-static > PATH)
# FFMPEG_PATH="/usr/bin/ffmpeg"

# --- Vercel/serverless deployment ---
# Set these in the Vercel project env (not needed locally):
# DATABASE_URL=<pooled Neon URL — durable Postgres shared by every function instance>
# BLOB_READ_WRITE_TOKEN=<Vercel Blob store token — durable media; without it
#   generated files stay per-instance /tmp scratch (ephemeral by design)>
#
# Durable media storage (Vercel Blob, since T11). With the token set, every
# generated still/clip uploads to the blob store and the database remembers
# the absolute CDN URL; without it behavior is byte-for-byte the local-mode
# /generated/... paths (dev parity). Deliberately NOT set in local .env —
# the hermetic Vitest suite must never touch the real store.
