// Somnia — clean-room AI video studio.
// Prisma schema: multi-user accounts + sessions, per-user credit ledger
// (APPEND-ONLY by convention — never update or delete rows), generation job
// pipeline with ordered keyframes (up to 16), boards, likes, API keys and
// agent runs.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  passwordHash   String? // null for OAuth-only accounts
  name           String
  avatarSeed     String    @default("aurora")
  plan           String    @default("trial") // trial | spark | studio | infinite
  planCycleStart DateTime? // start of the current monthly cycle (pool grants land each cycle)
  credits        Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  jobs      Job[]
  ledger    CreditTransaction[]
  sessions  Session[]
  boards    Board[]
  likes     Like[]
  apiKeys   ApiKey[]
  agentRuns AgentRun[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique // sha256 of the opaque cookie token
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Job {
  id             String   @id @default(cuid())
  userId         String
  kind           String   @default("video") // video | image
  mode           String   @default("create") // create | modify | extend | agent | remix
  prompt         String
  enhancedPrompt String? // brainstorm variant actually used (if any)
  model          String   @default("pulse-3") // pulse-3 | pulse-flash | prism
  resolution     String   @default("720p") // 540p | 720p | 1080p
  aspectRatio    String   @default("16:9")
  durationSec    Int      @default(5) // 5 | 10 (0 for image jobs)
  hdr            Boolean  @default(false)
  loop           Boolean  @default(false)
  startFramePath String? // first pinned frame (image-to-video / keyframes)
  endFramePath   String? // last pinned frame
  parentJobId    String? // edit-thread lineage
  sourceJobId    String? // extend / modify / remix source job
  agentRunId     String?
  boardId        String?
  status         String   @default("queued") // queued | dispatched | running | moderated | completed | failed
  progress       Int      @default(0)
  errorMessage   String?
  creditsCharged Int      @default(0)
  providerCostUsd Float   @default(0)
  idempotencyKey String   @unique
  shareToken     String?  @unique // public unlisted /share/<token> link
  sharedAt       DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  board        Board?             @relation(fields: [boardId], references: [id])
  keyframes    Keyframe[]
  generations  Generation[]
  assets       Asset[]
  transactions CreditTransaction[]
  likes        Like[]
}

// Ordered pinned timeline frames for a job (Luma-style keyframes, max 16).
model Keyframe {
  id        String   @id @default(cuid())
  jobId     String
  order     Int // 1..16 position in the pinned timeline
  path      String
  createdAt DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model Generation {
  id         String   @id @default(cuid())
  jobId      String
  provider   String // 'demo' | 'fal' | 'selfhosted'
  status     String // 'queued' | 'dispatched' | 'running' | 'succeeded' | 'failed'
  framesJson String   @default("[]")
  videoPath  String?
  imagePath  String?
  createdAt  DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model Asset {
  id         String   @id @default(cuid())
  jobId      String
  kind       String // frame | startFrame | endFrame | video | reframe | camera | upscale | poster
  path       String
  label      String?
  variantKey String? // idempotency key per (job, variant) — e.g. "reframe-9x16", "upscale-4k"
  createdAt  DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

// APPEND-ONLY ledger: every credit grant, charge and refund is recorded here.
model CreditTransaction {
  id             String    @id @default(cuid())
  userId         String
  jobId          String?
  amount         Int // signed: negative = charge, positive = grant/refund
  kind           String // 'signup' | 'monthly' | 'spend' | 'refund' | 'topup'
  note           String?
  balanceAfter   Int
  idempotencyKey String?   @unique // dedupe key for charged spends (e.g. job idempotency key)
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job? @relation(fields: [jobId], references: [id])
}

model Board {
  id          String    @id @default(cuid())
  userId      String
  name        String
  description String?
  shareToken  String?   @unique // public board share link
  sharedAt    DateTime?
  createdAt   DateTime  @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs Job[]
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  prefix     String // first characters shown in the UI
  hash       String    @unique // sha256 of the full key
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AgentRun {
  id            String    @id @default(cuid())
  userId        String
  goal          String
  planJson      String    @default("[]") // serialized plan steps
  status        String    @default("planning") // planning | running | completed | failed
  variations    Int       @default(0)
  creditsBudget Int       @default(0)
  createdAt     DateTime  @default(now())
  completedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
